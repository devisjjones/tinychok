TINYCHOK_APP_ENV=production
TINYCHOK_STORE_MODE=postgres
HOST=0.0.0.0
PORT=8787

# Public URLs for split frontend/backend/media domains.
PUBLIC_APP_URL=https://tinychok.ru
PUBLIC_API_URL=https://api.tinychok.ru
# Leave empty until a dedicated media gateway/domain exists.
PUBLIC_MEDIA_BASE_URL=
VITE_API_BASE_URL=https://api.tinychok.ru
VITE_WS_BASE_URL=wss://api.tinychok.ru

# Production analytics must stay explicit in the env contract too.
# If these keys are missing in the live env, the app falls back to
# analytics.disabled and Yandex Metrica silently stops ingesting.
# Switch provider=clickhouse only after the ClickHouse schema is applied and creds are live.
TINYCHOK_ANALYTICS_ENABLED=true
TINYCHOK_ANALYTICS_PROVIDER=log
TINYCHOK_ANALYTICS_FLUSH_INTERVAL_MS=5000
TINYCHOK_ANALYTICS_MAX_BATCH_SIZE=20
TINYCHOK_YANDEX_METRICA_COUNTER_ID=change-me
TINYCHOK_ANALYTICS_CLICKHOUSE_URL=https://rc1b-xxxxxxxxx.mdb.yandexcloud.net:8443
TINYCHOK_ANALYTICS_CLICKHOUSE_DATABASE=tinychok_analytics
TINYCHOK_ANALYTICS_CLICKHOUSE_TABLE=analytics_events
TINYCHOK_ANALYTICS_CLICKHOUSE_USER=tinychok_admin
TINYCHOK_ANALYTICS_CLICKHOUSE_PASSWORD=change-me
TINYCHOK_ANALYTICS_CLICKHOUSE_TIMEOUT_MS=5000

# Premium checkout through YooKassa.
TINYCHOK_PAYMENT_PROVIDER=yookassa
TINYCHOK_YOOKASSA_SHOP_ID=change-me
TINYCHOK_YOOKASSA_SECRET_KEY=change-me
TINYCHOK_YOOKASSA_RETURN_URL=https://tinychok.ru/premium
TINYCHOK_YOOKASSA_RECEIPTS_ENABLED=false
TINYCHOK_YOOKASSA_RECEIPT_VAT_CODE=1
TINYCHOK_YOOKASSA_RECEIPT_TIMEZONE=3

# Captcha is mandatory outside development.
TINYCHOK_CAPTCHA_PROVIDER=smartcaptcha
TINYCHOK_CAPTCHA_SITE_KEY=change-me
TINYCHOK_CAPTCHA_SECRET_KEY=change-me

# SMS OTP via sms.ru.
SMS_RU_API_ID=
SMS_RU_BASE_URL=https://sms.ru
SMS_OTP_HASH_SECRET=change-me
SMS_OTP_LENGTH=6
SMS_OTP_TTL_SECONDS=300
SMS_OTP_RESEND_COOLDOWN_SECONDS=60
SMS_OTP_MAX_SENDS_PER_PHONE_PER_DAY=5
SMS_OTP_MAX_SENDS_PER_IP_PER_DAY=10
SMS_OTP_MAX_VERIFY_ATTEMPTS=3
SMS_OTP_TEMPLATE=Ваш код: {CODE}
SMS_OTP_TEST_MODE=false

# Local fallback media storage. Production target is Yandex Object Storage.
TINYCHOK_MEDIA_BACKEND=object-storage
LOCAL_MEDIA_ROOT=server/uploads
STATE_DATA_FILE=server/data/dev-db.json

# Target production dependencies under Yandex Cloud.
POSTGRES_URL=
POSTGRES_HOST=rc1b-xxxxxxxxx.mdb.yandexcloud.net
POSTGRES_PORT=6432
POSTGRES_DB=tinychok
POSTGRES_USER=tinychok_app
POSTGRES_PASSWORD=change-me
POSTGRES_SSL=true
POSTGRES_STATE_TABLE=app_runtime_state
POSTGRES_BOOTSTRAP_FROM_FILE=true

OBJECT_STORAGE_ENDPOINT=https://storage.yandexcloud.net
OBJECT_STORAGE_BUCKET=tinychok-media-prod
OBJECT_STORAGE_REGION=ru-central1
OBJECT_STORAGE_ACCESS_KEY=change-me
OBJECT_STORAGE_SECRET_KEY=change-me
OBJECT_STORAGE_SIGNED_URL_TTL_SECONDS=300
