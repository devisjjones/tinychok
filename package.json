{
  "name": "tinychok",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite --host 127.0.0.1 --port 5174",
    "dev:server": "tsx watch server/src/index.ts",
    "deploy:staging": "bash scripts/deploy-staging.sh",
    "install:staging-command": "bash scripts/install-staging-deploy-command.sh",
    "build": "tsc -b && npm run build:server && npm run build:frontend",
    "build:staging": "tsc -b && npm run build:server && npm run build:frontend:staging && npm run verify:staging-dist",
    "build:frontend": "vite build",
    "build:frontend:staging": "VITE_API_BASE_URL=https://api.staging.tinychok.ru VITE_WS_BASE_URL=wss://api.staging.tinychok.ru vite build",
    "build:server": "tsup server/src/index.ts --format esm --platform node --target node24 --out-dir dist-server --clean",
    "bootstrap:staff": "tsx scripts/bootstrap-staff.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "start:server": "node dist-server/index.js",
    "test:ui-contracts": "node --test --import tsx server/src/ui-runtime-regressions.test.ts server/src/release-gate-contracts.test.ts server/src/persisted-auth-storage.test.ts server/src/json-file-persistence.test.ts",
    "test:gate": "npm run lint && npm test && npm run test:ui-contracts && npm run audit:release && npm run build:staging",
    "test": "node --test --import tsx server/src/*.test.ts",
    "audit:release": "npm audit --audit-level=high",
    "verify:staging-dist": "node scripts/verify-staging-dist.mjs",
    "verify:staging-runtime": "node scripts/verify-release-runtime.mjs --client-config-url https://api.staging.tinychok.ru/api/client-config --health-url https://api.staging.tinychok.ru/healthz --ready-url https://api.staging.tinychok.ru/readyz --require-analytics --expected-metrica-counter-id 108249405 --expected-analytics-provider ${TINYCHOK_EXPECTED_ANALYTICS_PROVIDER:-clickhouse}"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@aws-sdk/s3-request-presigner": "^3.1013.0",
    "@fastify/cors": "^11.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^9.0.0",
    "@fastify/websocket": "^11.2.0",
    "fastify": "^5.6.1",
    "fflate": "^0.8.2",
    "ffmpeg-static": "^5.3.0",
    "pg": "^8.20.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.0.7"
  }
}
